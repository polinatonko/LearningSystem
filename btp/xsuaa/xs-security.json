{
  "xsappname": "lms",
  "tenant-mode": "shared",
  "oauth2-configuration": {
    "redirect-uris" : [
      "https://*.us10-001.hana.ondemand.com/login/callback"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.Administrate",
      "description": "Administrate application"
    },
    {
      "name": "$XSAPPNAME.Callback",
      "description": "With this scope set, the callbacks for subscribe, unsubscribe and getDependencies can be called.",
      "grant-as-authority-to-apps": [
        "$XSAPPNAME(application,sap-provisioning,tenant-onboarding)"
      ]
    },
    {
      "name": "$XSAPPNAME.Manage",
      "description": "Perform management operations"
    },
    {
      "name": "$XSAPPNAME.Read",
      "description": "Read content"
    },
    {
      "name": "$XSAPPNAME.Write",
      "description": "Write content"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Admin of LMS",
      "scope-references": ["$XSAPPNAME.Read", "$XSAPPNAME.Write", "$XSAPPNAME.Manage", "$XSAPPNAME.Administrate"]
    },
    {
      "name": "Manager",
      "description": "Manager of LMS",
      "scope-references": ["$XSAPPNAME.Read", "$XSAPPNAME.Write", "$XSAPPNAME.Manage"]
    },
    {
      "name": "Student",
      "description": "Student of LMS",
      "scope-references": ["$XSAPPNAME.Read", "$XSAPPNAME.Write"]
    }
  ],
  "role-collections": [
    {
      "name": "LMS Admin",
      "description": "Admin of LMS",
      "role-template-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "LMS Manager",
      "description": "Manager of LMS",
      "role-template-references": [
        "$XSAPPNAME.Manager"
      ]
    },
    {
      "name": "LMS Student",
      "description": "Student of LMS",
      "role-template-references": [
        "$XSAPPNAME.Student"
      ]
    }
  ]
}